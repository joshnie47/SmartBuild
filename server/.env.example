MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>
PORT=5000
JWT_SECRET=smartbuild_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=7d
GROQ_API_KEY=your_groq_api_key

# Phone Authentication Mode: 'twilio' (production default) or 'demo' (testing only)
PHONE_OTP_MODE=twilio

# Twilio Verify Service Credentials
# 1. Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# 2. Twilio Auth Token (32-character secret)
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# 3. Twilio Verify Service SID (starts with VA...)
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Resend Email Service Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

